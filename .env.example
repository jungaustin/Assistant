# Spotify API (required for music control tools)
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
REFRESH_TOKEN=your_spotify_refresh_token

# LLM Provider Selection
# Set to "openai" (cloud) or "ollama" (local)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Ollama settings (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API (only required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key

# TTS (Text-to-Speech) Provider
# Set to "openai", "coqui", or "piper" (piper = local, no network)
TTS_PROVIDER=piper
TTS_VOICE=
# Path to Piper voice .onnx file (only used if TTS_PROVIDER=piper)
PIPER_VOICE_PATH=models/tts/en-us-amy-medium/en_US-amy-medium.onnx

# STT (Speech-to-Text) Provider
# Currently only realtimestt is supported
STT_PROVIDER=realtimestt
# Whisper model size. Auto-downloaded on first run, cached under
# ~/.cache/huggingface. Tradeoff: bigger = more accurate, slower, more RAM.
#   tiny.en        ~75MB   fast, mishears slurred speech
#   base.en        ~140MB  noticeable accuracy bump
#   small.en       ~460MB  sweet spot for desk-robot use (default)
#   medium.en      ~1.5GB  near-human, slower on CPU
#   distil-large-v3 ~750MB ~95% of large-v3 quality at 3x speed
STT_MODEL=small.en

# Privacy & Safety Settings
# Set to "true" or "false" to enable/disable microphone
MIC_ENABLED=true
# Hard cap on a single utterance (seconds)
MAX_UTTERANCE_SECONDS=30
# After the agent finishes speaking, keep the mic open this long for a
# follow-up turn without requiring the wake word. MicGate still applies.
FOLLOWUP_WINDOW_SECONDS=20
# Path to log camera access attempts
CAMERA_LOG_PATH=camera_access.log
