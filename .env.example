# Spotify API (required for music control tools)
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
REFRESH_TOKEN=your_spotify_refresh_token

# Spotify re-authorization. Refresh tokens expire after six months; when that
# happens the robot opens the Spotify login in your browser on its own, you
# click Agree, and it saves the new token and carries on with what you asked.
# You can also just say "reconnect Spotify".
#   SPOTIFY_AUTO_REAUTH=false   — don't open a browser; tell the user to run
#                                 setup/spotify_oauth_bootstrap.py instead.
#   SPOTIFY_AUTH_WAIT_SECONDS   — how long a tool call waits for your click
#                                 before answering anyway (default 60).
#   SPOTIFY_REDIRECT_URI        — must also be registered as a Redirect URI on
#                                 the Spotify app dashboard (default
#                                 http://127.0.0.1:5000/callback). Change it if
#                                 macOS AirPlay Receiver has taken port 5000.

# Whisper decoding bias. Without this "log" is transcribed as "long" almost
# every time ("Long for me 240 calories for tofu"), which the brain cannot
# reliably recover from. Keep it short — a long prompt makes Whisper echo it
# back on near-silent audio. Set empty to disable.
# STT_INITIAL_PROMPT=Nemo, log 600 calories for rice. Log my weight.

# Tavily web search (required for web_search tool — get a key at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# Discord bot (send_discord_message / catch_up_discord tools). To set up:
#   1. https://discord.com/developers/applications → New Application
#   2. Bot tab → Reset Token → paste it below
#   3. Bot tab → Privileged Gateway Intents → enable "Message Content Intent"
#   4. OAuth2 → URL Generator → scope "bot" → permissions: View Channels,
#      Send Messages, Read Message History → open the generated URL and
#      pick your server (you need Manage Server permission there)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Nightly check-in: at this local hour Nemo asks about any of the listed
# tracker types that haven't been logged today. Set the hour to -1 (or the
# list to empty) to disable.
DAILY_LOG_PROMPT_HOUR=22
DAILY_REQUIRED_TYPES=calories,exercise,sleep

# LLM Provider Selection
# "openai-compat" talks to any OpenAI-compatible HTTP endpoint (OpenAI itself,
# Ollama at /v1, Together, vLLM). "ollama" uses langchain-ollama directly.
# Default is openai-compat so swapping providers is one env var.
LLM_PROVIDER=openai-compat
LLM_MODEL=gpt-4o-mini

# Base URL for the openai-compat client. Leave unset for OpenAI's default
# (https://api.openai.com/v1). Point at Ollama with:
#   BRAIN_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:32b
BRAIN_BASE_URL=
# API key for the openai-compat client. When set, overrides OPENAI_API_KEY.
# Leave blank to use OPENAI_API_KEY. Local servers (Ollama) accept any
# non-empty string and are auto-stubbed when BRAIN_BASE_URL is set.
BRAIN_API_KEY=

# Ollama settings (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API key (used by openai-compat when BRAIN_API_KEY is unset)
OPENAI_API_KEY=your_openai_api_key

# TTS (Text-to-Speech) Provider
# Set to "openai", "coqui", or "piper" (piper = local, no network)
TTS_PROVIDER=piper
TTS_VOICE=
# Path to Piper voice .onnx file (only used if TTS_PROVIDER=piper)
PIPER_VOICE_PATH=models/tts/en-us-amy-medium/en_US-amy-medium.onnx

# STT (Speech-to-Text) Provider
# Currently only realtimestt is supported
STT_PROVIDER=realtimestt
# Whisper model size. Auto-downloaded on first run, cached under
# ~/.cache/huggingface. Tradeoff: bigger = more accurate, slower, more RAM.
#   tiny.en        ~75MB   fast, mishears slurred speech
#   base.en        ~140MB  noticeable accuracy bump
#   small.en       ~460MB  sweet spot for desk-robot use (default)
#   medium.en      ~1.5GB  near-human, slower on CPU
#   distil-large-v3 ~750MB ~95% of large-v3 quality at 3x speed
STT_MODEL=small.en
# Pin the capture device by a case-insensitive substring of its PyAudio name.
# Empty/unset = system default input. Set this when you use Bluetooth
# headphones: if the headset becomes the default input and the robot captures
# from it, macOS drops the headset into low-quality HFP mode — pinning the
# built-in mic keeps the headset output-only (crisp A2DP audio). List names:
#   uv run python -c "import pyaudio; p=pyaudio.PyAudio(); [print(p.get_device_info_by_index(i)['name']) for i in range(p.get_device_count())]"
# STT_INPUT_DEVICE=MacBook Pro Microphone

# Privacy & Safety Settings
# Set to "true" or "false" to enable/disable microphone
MIC_ENABLED=true
# Hard cap on a single utterance (seconds)
MAX_UTTERANCE_SECONDS=30
# After the agent finishes speaking, keep the mic open this long for a
# follow-up turn without requiring the wake word. MicGate still applies.
FOLLOWUP_WINDOW_SECONDS=20
# Path to log camera access attempts
CAMERA_LOG_PATH=camera_access.log

# Persona system prompt. Swap this file (or set PERSONA_PATH) to change the
# agent's personality without touching code.
PERSONA_PATH=personas/nemo.md

# Transport seam (Phase 8 Pi/Mac split). "inproc" runs Brain + Edge in one
# process (the default). "websocket" makes robot.main run Edge-only and
# connect to a brain server (`just brain` / python -m robot.brain_server).
TRANSPORT=inproc
# Client side: where the Edge finds the brain server.
BRAIN_WS_URL=ws://localhost:8765
# Server side: bind address/port. localhost is loopback-only; set
# BRAIN_WS_HOST=0.0.0.0 when the Pi needs to reach the brain over the LAN.
BRAIN_WS_HOST=localhost
BRAIN_WS_PORT=8765
# Shared secret, required for TRANSPORT=websocket — must match on both
# machines. Generate: python -c "import secrets; print(secrets.token_hex(32))"
TRANSPORT_TOKEN=

# Conversation state. SqliteSaver writes here so the process survives
# restart with conversation memory intact. Parent dir auto-created.
# Default thread_id is today's local date — conversations reset overnight.
# (state/ is gitignored.)
STATE_DB_PATH=state/conversations.db

# Durable episodic memory — the cross-day log that recall() searches.
# Separate file from STATE_DB_PATH so episodic writes don't contend with
# LangGraph's checkpointer connection. (state/ is gitignored.)
MEMORY_DB_PATH=state/memory.db

# Google Calendar. To set up:
#   1. Create a Google Cloud project + enable the Calendar API
#   2. Make an OAuth 2.0 Client ID (type: Desktop app)
#   3. Add yourself as a test user (OAuth consent screen → Testing mode)
#   4. Download the client JSON to state/google-credentials.json
#   5. Run `just oauth-calendar` — opens browser, saves refresh token
# After that the runtime client refreshes the access token automatically.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS_PATH=state/google-credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=state/google-calendar-token.json

# Clip-that — the "clip that" dashcam loop (core/clip.py). Opt-in: it opens
# a screen capture + a second mic stream at boot, and needs Screen Recording
# permission granted to whatever launches the robot (Terminal for `just run`).
# Build the capture helper once with `just build-clip-recorder`; verify the
# whole stack with `just clip-smoke`. Say "clip that" (or "save that clip")
# to save the last minute to CLIP_SAVE_DIR. Footage lives ONLY on a RAM disk
# until saved; the deafen key (PgDn) flushes it instantly.
CLIP_ENABLED=false
#CLIP_SAVE_DIR=~/Movies/Nemo Clips
# Engine numbers below are Phase 1 gate results (prototype/clip-gate/REPORT.md);
# raise CLIP_BITRATE first if text looks soft on a Retina display.
#CLIP_BITRATE=8000000
#CLIP_RAMDISK_MB=256
#CLIP_WINDOW_SECONDS=60
#CLIP_SNAPSHOT_TTL=120

# DoorDash ordering via the `dd-cli` beta binary (waitlist-only; see
# github.com/doordash-oss/doordash-cli). Opt-in because these tools spend
# real money. Setup, once:
#   1. Download + verify the release tarball, run its install.sh
#      (puts dd-cli in ~/.local/bin — make sure that's on PATH)
#   2. `dd-cli login` — credentials go to the macOS keychain, never here
#   3. set DOORDASH_ENABLED=true
# Nemo never places an order without reading it back and hearing you say
# yes on a later turn; that gate is enforced in code (doordash_client.py),
# not just in the persona.
DOORDASH_ENABLED=false
#DOORDASH_BIN=dd-cli
# Hard ceiling on an unattended order. Above this Nemo refuses and hands it
# back to you — a backstop against a misheard quantity.
#DOORDASH_MAX_ORDER_CENTS=15000
# How long a read-back quote stays good before Nemo re-prices instead.
#DOORDASH_CONFIRM_TTL=600
# dd-cli requires an --intent string per command and says DoorDash may
# review it for research. Default sends a fixed, non-personal string; set
# true to send your own phrasing instead.
#DOORDASH_SHARE_INTENT=false
#DOORDASH_TIMEOUT=60
