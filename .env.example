# Spotify API (required for music control tools)
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
REFRESH_TOKEN=your_spotify_refresh_token

# LLM Provider Selection
# "openai-compat" talks to any OpenAI-compatible HTTP endpoint (OpenAI itself,
# Ollama at /v1, Together, vLLM). "ollama" uses langchain-ollama directly.
# Default is openai-compat so swapping providers is one env var.
LLM_PROVIDER=openai-compat
LLM_MODEL=gpt-4o-mini

# Base URL for the openai-compat client. Leave unset for OpenAI's default
# (https://api.openai.com/v1). Point at Ollama with:
#   BRAIN_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:32b
BRAIN_BASE_URL=
# API key for the openai-compat client. When set, overrides OPENAI_API_KEY.
# Leave blank to use OPENAI_API_KEY. Local servers (Ollama) accept any
# non-empty string and are auto-stubbed when BRAIN_BASE_URL is set.
BRAIN_API_KEY=

# Ollama settings (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API key (used by openai-compat when BRAIN_API_KEY is unset)
OPENAI_API_KEY=your_openai_api_key

# TTS (Text-to-Speech) Provider
# Set to "openai", "coqui", or "piper" (piper = local, no network)
TTS_PROVIDER=piper
TTS_VOICE=
# Path to Piper voice .onnx file (only used if TTS_PROVIDER=piper)
PIPER_VOICE_PATH=models/tts/en-us-amy-medium/en_US-amy-medium.onnx

# STT (Speech-to-Text) Provider
# Currently only realtimestt is supported
STT_PROVIDER=realtimestt
# Whisper model size. Auto-downloaded on first run, cached under
# ~/.cache/huggingface. Tradeoff: bigger = more accurate, slower, more RAM.
#   tiny.en        ~75MB   fast, mishears slurred speech
#   base.en        ~140MB  noticeable accuracy bump
#   small.en       ~460MB  sweet spot for desk-robot use (default)
#   medium.en      ~1.5GB  near-human, slower on CPU
#   distil-large-v3 ~750MB ~95% of large-v3 quality at 3x speed
STT_MODEL=small.en

# Privacy & Safety Settings
# Set to "true" or "false" to enable/disable microphone
MIC_ENABLED=true
# Hard cap on a single utterance (seconds)
MAX_UTTERANCE_SECONDS=30
# After the agent finishes speaking, keep the mic open this long for a
# follow-up turn without requiring the wake word. MicGate still applies.
FOLLOWUP_WINDOW_SECONDS=20
# Path to log camera access attempts
CAMERA_LOG_PATH=camera_access.log

# Persona system prompt. Swap this file (or set PERSONA_PATH) to change the
# agent's personality without touching code.
PERSONA_PATH=personas/nemo.md

# Conversation state. SqliteSaver writes here so the process survives
# restart with conversation memory intact. Parent dir auto-created.
# Default thread_id is today's local date — conversations reset overnight.
# (state/ is gitignored.)
STATE_DB_PATH=state/conversations.db

# Durable episodic memory — the cross-day log that recall() searches.
# Separate file from STATE_DB_PATH so episodic writes don't contend with
# LangGraph's checkpointer connection. (state/ is gitignored.)
MEMORY_DB_PATH=state/memory.db
